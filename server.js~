// Define the root route to serve the frontend HTML file
// In a real application, you might use app.use(express.static('public'))
// and have index.html inside the 'public' folder.
// For this basic example, we'll send the file directly.
app.get('/', (req, res) => {
    // __dirname is the directory name of the current module.
    // This sends the index.html file located in the same directory as server.js.
    res.sendFile(__dirname + '/index.html');
    //res.status(200).json({message: 'User data.'});
});


// Start the server and listen for incoming requests
app.listen(PORT, () => {
    console.log(`Backend server running on http://localhost:${PORT}`);
    console.log(`Frontend accessible at http://localhost:${PORT}`);
    
});

